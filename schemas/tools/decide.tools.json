[
  {
    "type": "function",
    "function": {
      "name": "fgs_seed",
      "description": "启动 FGS 运行并种题：写入 fact_origin 与 goal_final（同一个 workspace 只种一次）。",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": ["brief"],
        "properties": {
          "brief": { "type": "string", "description": "题目原始信息；超过 8KiB 改传文件路径" },
          "target": { "type": "string", "description": "目标地址/入口，可选" },
          "title": { "type": "string", "description": "origin fact 标题，默认「题目信息:」" },
          "criterion": { "type": "string", "description": "goal_final 完成判据，可选" }
        }
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "fgs_preview",
      "description": "只读投影当前图（fact 仅 id+title）并附未提交草稿。规划前先看这个。",
      "parameters": { "type": "object", "additionalProperties": false, "properties": {} }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "fgs_open_step",
      "description": "草稿：新开一个 open step。from 非空（因果铁律）；stepId 可选预分配（batch commit）。",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action", "from"],
        "properties": {
          "action": { "type": "string", "description": "一句话动作方向，不写分步剧本" },
          "from": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" },
            "description": "依赖 fact id，不能为空（建议 1-3 个）"
          },
          "actor": { "type": "string", "description": "默认 agent" },
          "priority": { "type": "string", "enum": ["high", "normal", "low"], "description": "默认 normal" },
          "stepId": { "type": "string", "description": "可选预分配 step_NNN（如 step_001）；非法 id 如 step_recon 会拒收，留空则自动分配" }
        }
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "fgs_drop_step",
      "description": "草稿：撤销一个仍为 open 的 step。必须写 reason。",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stepId", "reason"],
        "properties": {
          "stepId": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "fgs_change_step_priority",
      "description": "草稿：调整 open step 优先级。reason 可选，不写回 step YAML。",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stepId", "priority"],
        "properties": {
          "stepId": { "type": "string" },
          "priority": { "type": "string", "enum": ["high", "normal", "low"] },
          "reason": { "type": "string" }
        }
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "fgs_satisfy_goal",
      "description": "草稿：置 goal 达成。commit 后写入 satisfiedBy/satisfiedReason/satisfiedAt。FLAG 类须过外部 verify hook 才可 commit。",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": ["goalId", "reason", "satisfiedBy"],
        "properties": {
          "goalId": { "type": "string" },
          "reason": { "type": "string" },
          "satisfiedBy": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          }
        }
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "fgs_reopen",
      "description": "草稿：假 FLAG/裁判打回时清空 goal 的 satisfied*，并追加 feedback Fact；禁止删历史。",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": ["goalId", "reason"],
        "properties": {
          "goalId": { "type": "string" },
          "reason": { "type": "string", "description": "打回/失败原因，写入 feedback Fact" },
          "feedbackTitle": { "type": "string", "description": "可选；默认用 reason 截断作 title" }
        }
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "fgs_commit",
      "description": "一次性提交草稿；或带 operations[] 批量子提交（可预分配 stepId），有 operations[] 时忽略当前草稿。不调用则本轮作废。",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "operations": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["op"],
              "properties": {
                "op": { "type": "string", "enum": ["open_step", "drop_step", "change_step_priority", "satisfy_goal", "reopen", "add_subgoal", "drop_subgoal", "claim_step"] },
                "stepId": { "type": "string" },
                "action": { "type": "string" },
                "actor": { "type": "string" },
                "from": { "type": "array", "items": { "type": "string" } },
                "priority": { "type": "string", "enum": ["high", "normal", "low"] },
                "reason": { "type": "string" },
                "goalId": { "type": "string" },
                "criterion": { "type": "string" },
                "parentId": { "type": "string" },
                "owner": { "type": "string" },
                "satisfiedBy": { "type": "array", "items": { "type": "string" } },
                "feedbackTitle": { "type": "string" }
              }
            }
          },
          "clearDraftOnFailure": { "type": "boolean", "description": "默认 false：失败时保留草稿" }
        }
      }
    }
  }
]
